# WalletConnect / Reown Cloud — free Project ID
# https://cloud.reown.com  →  Create project → copy Project ID
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Solana mainnet treasury (base58)
VITE_TREASURY_SOL=

# Printify (server-side only — never expose as VITE_*)
# https://printify.com → My Profile → Connections → API tokens
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Printify webhook HMAC secret (optional but recommended in production)
# Passed as "secret" when creating webhooks; verify X-Pfy-Signature header
PRINTIFY_WEBHOOK_SECRET=
# Previous secret during rotation (optional)
PRINTIFY_WEBHOOK_SECRET_PREVIOUS=
# Reject events older than N seconds (0 = off)
PRINTIFY_WEBHOOK_MAX_AGE_SEC=0
# HMAC diagnostics (never enable in public prod logs)
PRINTIFY_HMAC_DIAG=


# Public webhook URL override (default: https://factory.lvlltd.com/api/printify/webhooks)
PRINTIFY_WEBHOOK_URL=

# Require valid signature in production (set 1 to force 403 on bad sig when secret set)
PRINTIFY_WEBHOOK_STRICT=

# Cloudflare WAF apply script
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=lvlltd.com

# Origin + worker webhook gates
WEBHOOK_GATE_TOKEN=
WEBHOOK_ADMIN_TOKEN=
ENFORCE_SIGNATURE=

# ---------------------------------------------------------------------------
# Vercel CLI (local / agent only — never commit real tokens)
# Create: https://vercel.com/account/tokens  (team tesla-trek)
# Login:  VERCEL_TOKEN=… npm run vercel:auth:login
# Prefer putting the token in .env.vercel (gitignored) instead of .env
# ---------------------------------------------------------------------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=team_EbvXskCGZVZiHauixSNsUAKv
# VERCEL_PROJECT_ID=prj_0m75OJchmM0HOizAy7hTqdKghyPR


# ---------------------------------------------------------------------------
# AWS via Vercel OIDC (production only — no static access keys)
# Apply IAM: infra/aws/lvl-factory-oidc.yaml  ·  npm run aws:oidc:print
# Enable OIDC: npm run vercel:oidc:enable
# ---------------------------------------------------------------------------
# AWS_ACCOUNT_ID=123456789012
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/lvl-factory-runtime-prod
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-factory-bucket
# AWS_S3_PREFIX=factory/
# AWS_OIDC_AUDIENCE=

# HMAC for sealed agent order tokens (optional; falls back to stable derived secret)
AGENT_ORDER_SECRET=

