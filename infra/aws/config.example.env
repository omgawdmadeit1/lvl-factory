# Copy to infra/aws/config.env (gitignored) or export in shell before apply.
# AWS account ID is 12 digits (IAM console top-right, or: aws sts get-caller-identity)

AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=factory/
AWS_ROLE_NAME=lvl-factory-runtime-prod

# After stack deploy, paste RoleArn here for vercel:env:sync:
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT:role/lvl-factory-runtime-prod
